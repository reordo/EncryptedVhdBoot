## @file
# Minimal VeraCrypt crypto library used by the VHD boot preloader.
#
# The source files are hard-linked from the pinned upstream VeraCrypt submodule
# into VeraCrypt-DCS by its own mklinks_src.bat script. DCS-specific UI, TPM,
# configuration, filesystem, and random-generation wrappers are deliberately
# excluded.
#
# Copyright (c) 2026, Keishin Senzaki. All rights reserved.
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = EvbVeraCryptCryptoLib
  FILE_GUID                      = 91CCCE22-B98D-4DF6-8FE8-888A37BBFC50
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  LIBRARY_CLASS                  = VeraCryptLib|UEFI_APPLICATION

